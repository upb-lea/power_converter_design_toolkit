# python libraries
import csv
import threading
import os

# 3rd party libraries
import webbrowser
import uvicorn
from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from fastapi.templating import Jinja2Templates
from starlette.requests import Request
from starlette.responses import FileResponse
from fastapi.staticfiles import StaticFiles

# own libraries

# Path names
# Root directory
PCDT_ROOT: str
SUMMARY_DATA_CSV: str
CIRCUIT_DATA_CSV: str
CAPACITOR_DATA_BASE: str
INDUCTOR_DATA_BASE: str
TRANSFORMER_DATA_BASE: str
CAPACITOR0_CSV: str
CAPACITOR1_CSV: str
INDUCTOR_CSV: str
TRANSFORMER_CSV: str
HEAT_SINK_CSV: str
VISUALIZATION_BASE_DIR: str

# Allocate FastAPI instance
app = FastAPI()
templates: Jinja2Templates
# Variable declaration
candidates_key_list: list[dict] = []

def initialize_path(act_workspace_name: str):
    # Variable declaration
    global PCDT_ROOT, SUMMARY_DATA_CSV, CIRCUIT_DATA_CSV, CAPACITOR_DATA_BASE, INDUCTOR_DATA_BASE, VISUALIZATION_BASE_DIR
    global TRANSFORMER_DATA_BASE, CAPACITOR0_CSV, CAPACITOR1_CSV, INDUCTOR_CSV, TRANSFORMER_CSV, HEAT_SINK_CSV
    global app, templates

    # Find root directory
    act_dir = os.path.dirname(os.path.abspath(__file__))
    # Search for workspace name
    path_part_list = act_dir.split(os.sep)
    # Check if it exists
    if act_workspace_name in path_part_list:
        # Re-assemble to a path
        index = path_part_list.index(act_workspace_name)
        sub_path_list = path_part_list[:index + 1]
        PCDT_ROOT = os.sep.join(sub_path_list)
    else:
        # Search for subdirectory in workspace
        pathlevel2 = os.path.join(act_dir, "workspace", act_workspace_name)
        pathlevel1 = os.path.join(act_dir, act_workspace_name)

        if os.path.isdir(pathlevel2):
            PCDT_ROOT = pathlevel2
        elif os.path.isdir(pathlevel1):
            PCDT_ROOT = pathlevel1
        else:
            raise FileNotFoundError(f"Workspace folder {act_workspace_name} not found.\n Webserver is started outside project environment!")


    # Directory structure derivate from root directory
    SUMMARY_DATA_CSV = os.path.join(PCDT_ROOT, "{{ path_info.summary_data_csv }}")
    CIRCUIT_DATA_CSV = os.path.join(PCDT_ROOT, "{{ path_info.circuit_data_csv }}")
    CAPACITOR_DATA_BASE = os.path.join(PCDT_ROOT, "{{ path_info.capacitor_base_path }}")
    INDUCTOR_DATA_BASE = os.path.join(PCDT_ROOT, "{{ path_info.inductor_base_path }}")
    TRANSFORMER_DATA_BASE = os.path.join(PCDT_ROOT, "{{ path_info.transformer_base_path }}")
    CAPACITOR0_CSV = "{{ path_info.capacitor0_csv }}"
    CAPACITOR1_CSV = "{{ path_info.capacitor1_csv }}"
    INDUCTOR_CSV = "{{ path_info.inductor_csv }}"
    TRANSFORMER_CSV = "{{ path_info.transformer_csv }}"
    HEAT_SINK_CSV = os.path.join(PCDT_ROOT, "{{ path_info.heat_sink_csv }}")
    VISUALIZATION_BASE_DIR = os.path.join(PCDT_ROOT,"{{ path_info.visualization_base_path }}")

    # Register FastAPI
    # app.add_api_route(path="/", methods=["GET"], endpoint=startpage, response_class=HTMLResponse)

    # templates = Jinja2Templates(directory=os.path.join(VISUALIZATION_BASE_DIR, "templates"))
    templates = Jinja2Templates(directory=os.path.join(VISUALIZATION_BASE_DIR, "htmltemplates"))
    # app.mount("/StyleSheets", StaticFiles(directory=str(os.path.join(VISUALIZATION_BASE_DIR, "StyleSheets"))), name="css")
    app.mount("/StyleSheets", StaticFiles(directory= os.path.join(VISUALIZATION_BASE_DIR, "StyleSheets")),
              name="css")

def load_candidates()-> list [dict]:
    # Variable declaration
    candidates: list [dict] = []

    with open(SUMMARY_DATA_CSV, newline='', encoding='utf-8') as f:
        for row in csv.DictReader(f):
            candidates.append({
                'cid': row['combination_id'],
                'cir_id': row['circuit_id'],
                'cap0_id': row['capacitor_id_0'],
                'cap1_id': row['capacitor_id_1'],
                'ind_id': row['inductor_id_0'],
                'tr_id': row['transformer_id_0'],
                'hct_id': row['heat_sink_id']
            })

    return candidates


def get_candidate_ids(cid: int)-> dict:
    # Variable declaration
    candidate_ids: dict = {}

    # Check if list is available
    if candidates_key_list:
        # Find combinationId
        for candidate in candidates_key_list:
            if int(candidate["cid"]) == cid:
                candidate_ids = candidate
                break

    return candidate_ids

@app.get("/")
def startpage():
    # Return the start page
    return FileResponse(os.path.join(VISUALIZATION_BASE_DIR, "candidate_browser.html"))

@app.get("/detailed-view", response_class=HTMLResponse)
async def detailed_view(request: Request, combination_id: int):

    # Read csv-files for combination id
    candidate_data, plot_data = read_csv_data(combination_id)
    # candidate_info = get

    return templates.TemplateResponse(request,
        "browser_detailed_page_template.html",
         {"plot_data": plot_data, "cir_data": candidate_data["circuit_data"],
          "ind_data": candidate_data["inductor_data"], "tr_data": candidate_data["transformer_data"]}
     )


def read_component_plot_data(file_path: str, x_key: str, y_key: str, x_value: str, y_value: str) -> list[dict]:
    # Variable declaration
    plot_component_data: list[dict] = []

    # Check if file exists
    if os.path.isfile(file_path):
        with open(file_path, "r", newline="") as file:
            reader = csv.DictReader(file)
            # Get data from file
            for data_row in reader:
                # Check if row is valid
                if data_row["state"] == "COMPLETE":
                    plot_component_data.append({
                        x_value: data_row[x_key],
                        y_value: data_row[y_key],
                    })
    else:
        # Notify the user about not existing file
        print(f"File '{file_path}' does not exists!")

    return plot_component_data

def read_component_candidate_data(file_path: str, id_name: str, id: int, parameter_list: list[tuple[str, str]]) -> dict:
    # Variable declaration
    candidate_component_data: dict = {}
    data: dict|None = None

    # Check if file exists
    if os.path.isfile(file_path):
        with open(file_path, "r", newline="") as file:
            reader = csv.DictReader(file)
            # Find candidate
            for data_row in reader:
                # Check if row is valid
                if data_row["state"] == "COMPLETE" and data_row[id_name] == id:
                    data = data_row
                    break

        if data is not None:
            # Get values from row
            for item in parameter_list:
                value = data.get(item[0])
                candidate_component_data[item[1]] = value
                # Check if entry is valid
                if value is None:
                    print(f"Column {item[0]} does not exist")
    else:
        # Notify the user about not existing file
        print(f"File '{file_path}' does not exists!")

    return candidate_component_data

def read_csv_data(cid: int) -> tuple[dict, dict[str, list[dict]]]:
    # Variable declaration
    plot_data: dict[str, list[dict]] = {}
    candidate_data: dict = {}

    # Map cid to correspondent file pathes
    file_path_dict = get_file_path_list(cid)

    if file_path_dict:
        # Read plot data
        plot_data = read_csv_plot_data(file_path_dict)
        # Read design candidate data
        candidate_data = read_csv_candidate_data(file_path_dict, cid)
    # Return the candidate list
    return candidate_data, plot_data


def read_csv_plot_data(plot_file_path_dict: dict) -> dict[str, list[dict]]:
    # Variable declaration
    plot_data: dict[str, list[dict]] = {}

    # Read circuit plot data
    plot_data["circuit_data"] = read_component_plot_data(plot_file_path_dict["circuit_csv_file"],"values_0" , "values_1", "ZVS_rate" ,"Current_factor" )
    # Read inductor plot data
    plot_data["inductor_data"] = read_component_plot_data(plot_file_path_dict["inductor_csv_file"],"values_0" , "values_1", "total_volume" ,"total_mean_loss" )
    # Read transformer plot data
    plot_data["transformer_data"] = read_component_plot_data(plot_file_path_dict["transformer_csv_file"],"values_0" , "values_1", "total_volume" ,"total_mean_loss" )
    # Read heat sink plot data
    # plot_data["heat_sink"] = read_component_plot_data(plot_file_path_dict["inductor_csv_file"],"values_0" , "values_0", "volume" ,"ploss" )

    # Return the candidate list
    return plot_data

def read_csv_candidate_data(file_path_dict: dict, act_cid: int) -> dict[str, list[dict]]:
    # Variable declaration
    candidate_data: dict = {}
    # Parameter name in csv-sheet and browser template name
    circuit_parameter_list: list[tuple[str, str]] = [("params_f_s_suggest", "fs"), ("params_l_1_suggest", "l1"), ("params_l_2_suggest", "l2"),
                                                     ("params_l_s_suggest", "ls"), ("params_transistor_1_name_suggest", "T1_type"),
                                                     ("params_transistor_2_name_suggest", "T2_type")]
    inductor_parameter_list: list[tuple[str, str]] = [("values_0", "ind_vol"), ("values_1", "ind_loss"), ("user_attrs_flux_density_peak", "ind_peak_flux"),
                                                      ("params_core_name", "ind_core"), ("params_material_name", "ind_material"), ("params_material_name", "ind_l"),
                                                      ("params_turns", "ind_turns"), ("user_attrs_l_air_gap", "ind_airgap"), ("params_litz_wire_name", "ind_litz")]

    transformer_parameter_list: list[tuple[str, str]] = [("values_0", "tr_vol"), ("values_1", "tr_loss"), ("params_core_name", "tr_core"),
                                                         ("params_material_name", "tr_material"), ("params_core_name", "tr_l"), ("user_attrs_l_bot_air_gap", "tr_bot_airgap"),
                                                         ("user_attrs_l_top_air_gap", "tr_top_airgap"), ("params_primary_litz_name", "tr_litz_prim"),
                                                         ("params_secondary_litz_name", "tr_litz_sec"), ("params_n_p_top", "tr_turn_ptop"),
                                                         ("params_n_p_bot", "tr_turn_pbot"), ("params_n_s_bot", "tr_turn_sbot"), ("user_attrs_b_max_top", "tr_flux_top"),
                                                         ("user_attrs_core_inner_diameter", "tr_core_inner_dia"), ("user_attrs_b_max_middle", "tr_flux_mid"),
                                                         ("user_attrs_b_max_bot", "tr_flux_bot"), ("user_attrs_winding_losses", "tr_wind_loss")]

    # Find combinationId
    candidate_ids = get_candidate_ids(act_cid)

    # Read circuit data
    candidate_data["circuit_data"] = read_component_candidate_data(
        file_path_dict["circuit_csv_file"], "number", candidate_ids["cir_id"], circuit_parameter_list)

    # Read inductor data
    candidate_data["inductor_data"] = read_component_candidate_data(
        file_path_dict["inductor_csv_file"], "number", candidate_ids["ind_id"], inductor_parameter_list)

    # Read transformer data
    candidate_data["transformer_data"] = read_component_candidate_data(
        file_path_dict["transformer_csv_file"], "number", candidate_ids["tr_id"], transformer_parameter_list)

    # Read heat sink plot data
    # plot_data["heat_sink"] = read_component_plot_data(plot_file_path_dict["inductor_csv_file"],"values_0" , "values_0", "volume" ,"ploss" )

    # Return the candidate list
    return candidate_data

def get_file_path_list(cid: int) -> dict:
    # Variable declaration
    file_path_dict: dict = {}

    # Find the ids of the components
    candidate_ids = get_candidate_ids(cid)

    # Check if candidate is found
    if candidate_ids is not None:
        file_path_dict["circuit_csv_file"] = CIRCUIT_DATA_CSV
        file_path_dict["capacitor0_csv_file"] = os.path.join(CAPACITOR_DATA_BASE,candidate_ids["cir_id"], CAPACITOR0_CSV)
        file_path_dict["capacitor1_csv_file"] = os.path.join(CAPACITOR_DATA_BASE,candidate_ids["cir_id"], CAPACITOR1_CSV)
        file_path_dict["inductor_csv_file"] = os.path.join(INDUCTOR_DATA_BASE,candidate_ids["cir_id"], INDUCTOR_CSV)
        file_path_dict["transformer_csv_file"] = os.path.join(TRANSFORMER_DATA_BASE,candidate_ids["cir_id"], TRANSFORMER_CSV)
        file_path_dict["heat_sink_csv_file"] = HEAT_SINK_CSV

    return file_path_dict

def open_browser():
    # Wait a short time until server is started
    import time
    time.sleep(1.0)
    webbrowser.get('firefox').open("http://127.0.0.1:8000/")   # 👈 Firefox direkt
    # other browsers: webbrowser.open("http://127.0.0.1:8000/")

if __name__ == "__main__":
    # Initialize path
    initialize_path("{{ path_info.work_path }}")

    # Initialize candidate key list
    candidates_key_list = load_candidates()

    # Open browser in background thread
    threading.Timer(1.5, open_browser).start()
    # Start server (block mode)
    uvicorn.run(app, host="127.0.0.1", port=8000)

